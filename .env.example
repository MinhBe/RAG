# === Cơ sở dữ liệu ===
POSTGRES_USER=lawvn
POSTGRES_PASSWORD=lawvn-dev
POSTGRES_DB=lawvn
# DATABASE_URL được compose tự đặt cho container api; đặt ở đây khi chạy ngoài Docker:
# DATABASE_URL=postgresql://lawvn:lawvn-dev@localhost:5432/lawvn

# === LLM ===
# Nhà cung cấp chính cho từng loại việc. Xem backend/app/llm/router.py.
LLM_PROVIDER=auto

# Gemini (endpoint tương thích OpenAI của Google).
# Điền tối đa 10 key để xoay vòng khi gặp lỗi/giới hạn.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# Dahl (endpoint tương thích OpenAI) — nhà cung cấp chính.
# Một key dùng chung cho nhiều model; mỗi câu hỏi gửi song song tới mọi model
# trong DAHL_MODELS và lấy câu trả lời hợp lệ về sớm nhất. Điền tối đa 10 key.
Dahl_token_1=
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,zai-org/GLM-5.3-Flash,MiniMaxAI/MiniMax-M2.7
# low = nghĩ ngắn trước khi trả lời (nhanh hơn); để trống để model tự quyết.
DAHL_REASONING_EFFORT=low
# Dahl chưa trả lời sau ngần này giây thì gọi thêm Gemini vào đua (0 = tắt).
DAHL_HEDGE_AFTER=15

# Claude (Anthropic) — dùng cho soạn thảo / báo cáo dài.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# FPT AI Marketplace (tùy chọn — xử lý dữ liệu hàng loạt). Để trống nếu không dùng.
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_API_KEY=
FPT_MODEL=gpt-oss-20b

# === Embedding (tự host, không cần key) ===
# hashing = vector băm tất định, chạy ngay không tải model (dùng cho M0/M1).
# bge-m3 / vie-v2 = model thật, bật ở M2 (cần requirements-ml.txt).
EMBEDDER=hashing
EMBED_DIM=1024

# === Rerank ===
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# === Quan sát (tùy chọn) ===
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-dev-secret
LANGFUSE_SALT=change-me-dev-salt
