# Leave every key empty to run in offline mode (extractive answers, no API cost).
# With GEMINI_API_KEY set, calls go through the LiteLLM gateway; roles -> models in config/models.yaml.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# hashing (no download) | bge-m3 (install backend/requirements-ml.txt first)
EMBEDDER=hashing
